# TruthLens AI — Environment Configuration Template
# Copy this file to .env and fill in your actual credentials

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
FROM_EMAIL=TruthLens AI Security <your_email@gmail.com>

# Payment Gateway Configuration (Razorpay Sandbox/Live)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# SMS Verification Providers (Optional)
SMS_PROVIDER=fast2sms
FAST2SMS_API_KEY=your_fast2sms_api_key
TWOFACTOR_API_KEY=your_2factor_api_key
